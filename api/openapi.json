{
  "components": {
    "schemas": {
      "AddFieldInputBody": {
        "additionalProperties": false,
        "properties": {
          "$schema": {
            "description": "A URL to the JSON Schema for this object.",
            "examples": [
              "https://example.com/api/v1/schemas/AddFieldInputBody.json"
            ],
            "format": "uri",
            "readOnly": true,
            "type": "string"
          },
          "label": {
            "minLength": 1,
            "type": "string"
          }
        },
        "required": [
          "label"
        ],
        "type": "object"
      },
      "AspectTypeBody": {
        "additionalProperties": false,
        "properties": {
          "$schema": {
            "description": "A URL to the JSON Schema for this object.",
            "examples": [
              "https://example.com/api/v1/schemas/AspectTypeBody.json"
            ],
            "format": "uri",
            "readOnly": true,
            "type": "string"
          },
          "fields": {
            "description": "In position order. Empty on the list endpoint, which does not load them.",
            "items": {
              "$ref": "#/components/schemas/FieldBody"
            },
            "type": [
              "array",
              "null"
            ]
          },
          "id": {
            "type": "string"
          },
          "name": {
            "type": "string"
          },
          "team_id": {
            "type": "string"
          }
        },
        "required": [
          "id",
          "team_id",
          "name",
          "fields"
        ],
        "type": "object"
      },
      "AspectTypeListOutputBody": {
        "additionalProperties": false,
        "properties": {
          "$schema": {
            "description": "A URL to the JSON Schema for this object.",
            "examples": [
              "https://example.com/api/v1/schemas/AspectTypeListOutputBody.json"
            ],
            "format": "uri",
            "readOnly": true,
            "type": "string"
          },
          "items": {
            "items": {
              "$ref": "#/components/schemas/AspectTypeBody"
            },
            "type": [
              "array",
              "null"
            ]
          }
        },
        "required": [
          "items"
        ],
        "type": "object"
      },
      "Condition": {
        "additionalProperties": false,
        "properties": {
          "field": {
            "description": "A name from this resource's filter vocabulary.",
            "type": "string"
          },
          "op": {
            "description": "One of eq, neq, gt, gte, lt, lte, contains, in, is_null, is_not_null.",
            "type": "string"
          },
          "value": {
            "description": "A scalar, or an array for in. Omitted for is_null and is_not_null."
          }
        },
        "required": [
          "field",
          "op"
        ],
        "type": "object"
      },
      "CreateAspectTypeInputBody": {
        "additionalProperties": false,
