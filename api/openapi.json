              "https://example.com/api/v1/schemas/CreateTicketInputBody.json"
            ],
            "format": "uri",
            "readOnly": true,
            "type": "string"
          },
          "assignee_id": {
            "format": "uuid",
            "type": [
              "string",
              "null"
            ]
          },
          "description": {
            "type": "string"
          },
          "project_id": {
            "format": "uuid",
            "type": "string"
          },
          "status_id": {
            "format": "uuid",
            "type": [
              "string",
              "null"
            ]
          },
          "title": {
            "type": "string"
          }
        },
        "required": [
          "project_id",
          "title",
          "description",
          "status_id",
          "assignee_id"
        ],
        "type": "object"
      },
      "Error": {
        "additionalProperties": false,
        "properties": {
          "$schema": {
            "description": "A URL to the JSON Schema for this object.",
            "examples": [
              "https://example.com/api/v1/schemas/Error.json"
            ],
            "format": "uri",
            "readOnly": true,
            "type": "string"
          },
          "code": {
            "description": "Stable machine-readable identifier for this kind of failure. Never reworded.",
            "examples": [
              "ticket_archived"
            ],
            "type": "string"
          },
          "detail": {
            "description": "A human-readable explanation specific to this occurrence of the problem.",
            "examples": [
              "Property foo is required but is missing."
            ],
            "type": "string"
          },
          "errors": {
            "description": "Optional list of individual error details",
            "items": {
              "$ref": "#/components/schemas/ErrorDetail"
            },
            "type": [
              "array",
              "null"
            ]
          },
          "instance": {
            "description": "A URI reference that identifies the specific occurrence of the problem.",
            "examples": [
              "https://example.com/error-log/abc123"
            ],
            "format": "uri",
            "type": "string"
          },
          "status": {
            "description": "HTTP status code",
            "examples": [
              400
            ],
            "format": "int64",
            "type": "integer"
          },
          "title": {
            "description": "A short, human-readable summary of the problem type. This value should not change between occurrences of the error.",
            "examples": [
              "Bad Request"
            ],
            "type": "string"
          },
          "type": {
            "default": "about:blank",
            "description": "A URI reference to human-readable documentation for the error.",
            "examples": [
              "https://example.com/errors/example"
            ],
            "format": "uri",
            "type": "string"
          }
        },
        "required": [
          "code"
        ],
        "type": "object"
      },
      "ErrorDetail": {
        "additionalProperties": false,
        "properties": {
          "location": {
            "description": "Where the error occurred, e.g. 'body.items[3].tags' or 'path.thing-id'",
            "type": "string"
          },
          "message": {
            "description": "Error message text",
            "type": "string"
          },
          "value": {
            "description": "The value at the given location"
          }
        },
        "type": "object"
      },
      "FieldBody": {
        "additionalProperties": false,
        "properties": {
          "$schema": {
            "description": "A URL to the JSON Schema for this object.",
            "examples": [
              "https://example.com/api/v1/schemas/FieldBody.json"
            ],
            "format": "uri",
            "readOnly": true,
            "type": "string"
          },
          "id": {
            "description": "Stable forever. document.body is keyed by this, so it never changes - not even when the label does.",
            "type": "string"
          },
          "label": {
            "type": "string"
          },
          "position": {
            "description": "An ordering hint, not a slot. Duplicates are legal.",
            "format": "int64",
            "type": "integer"
          }
        },
        "required": [
          "id",
          "label",
          "position"
        ],
        "type": "object"
      },
      "Group": {
        "additionalProperties": false,
        "properties": {
          "conditions": {
            "items": {
              "$ref": "#/components/schemas/Condition"
            },
            "type": [
              "array",
              "null"
            ]
          },
          "groups": {
            "items": {
              "$ref": "#/components/schemas/Group"
            },
            "type": [
              "array",
              "null"
            ]
          },
          "op": {
            "description": "and or or. Joins every condition and subgroup in this group.",
            "type": "string"
          }
        },
        "required": [
          "op"
        ],
        "type": "object"
      },
      "ListEnvelopeTicketBody": {
        "additionalProperties": false,
        "properties": {
          "$schema": {
            "description": "A URL to the JSON Schema for this object.",
            "examples": [
              "https://example.com/api/v1/schemas/ListEnvelopeTicketBody.json"
            ],
            "format": "uri",
            "readOnly": true,
            "type": "string"
          },
          "has_more": {
            "type": "boolean"
          },
          "items": {
            "items": {
              "$ref": "#/components/schemas/TicketBody"
            },
            "type": [
              "array",
              "null"
            ]
          },
          "next_cursor": {
            "description": "Pass back as cursor for the next page. Null when there is none.",
            "type": [
              "string",
              "null"
            ]
          }
        },
        "required": [
          "items",
          "next_cursor",
          "has_more"
        ],
        "type": "object"
      },
      "ListRequest": {
        "additionalProperties": false,
        "properties": {
          "$schema": {
            "description": "A URL to the JSON Schema for this object.",
            "examples": [
              "https://example.com/api/v1/schemas/ListRequest.json"
            ],
            "format": "uri",
            "readOnly": true,
            "type": "string"
          },
          "cursor": {
            "description": "next_cursor from the previous page. Opaque - do not construct or parse it.",
            "type": "string"
          },
          "filter": {
            "$ref": "#/components/schemas/Group",
            "description": "Conditions and nested groups. Omitted means every row the caller may see."
          },
          "limit": {
            "description": "Rows per page. Omitted means 50. Over the maximum is rejected, not clamped.",
            "format": "int64",
            "maximum": 200,
            "minimum": 1,
            "type": "integer"
          },
          "sort": {
            "description": "Sort keys, most significant first. A unique tiebreak is always appended.",
            "items": {
              "$ref": "#/components/schemas/Order"
            },
            "type": [
              "array",
              "null"
            ]
          }
        },
        "type": "object"
      },
      "LoginInputBody": {
        "additionalProperties": false,
        "properties": {
          "$schema": {
            "description": "A URL to the JSON Schema for this object.",
            "examples": [
              "https://example.com/api/v1/schemas/LoginInputBody.json"
            ],
            "format": "uri",
            "readOnly": true,
            "type": "string"
          },
          "email": {
            "description": "Matched case-insensitively.",
            "examples": [
              "will@example.com"
            ],
            "type": "string"
          },
          "password": {
            "description": "Never logged, never echoed.",
            "type": "string"
          }
        },
        "required": [
          "email",
          "password"
        ],
        "type": "object"
      },
      "LoginOutputBody": {
        "additionalProperties": false,
        "properties": {
          "$schema": {
            "description": "A URL to the JSON Schema for this object.",
            "examples": [
              "https://example.com/api/v1/schemas/LoginOutputBody.json"
            ],
            "format": "uri",
            "readOnly": true,
            "type": "string"
          },
          "account_id": {
            "type": "string"
          }
        },
        "required": [
          "account_id"
        ],
        "type": "object"
      },
      "MeOutputBody": {
        "additionalProperties": false,
        "properties": {
          "$schema": {
            "description": "A URL to the JSON Schema for this object.",
            "examples": [
              "https://example.com/api/v1/schemas/MeOutputBody.json"
            ],
            "format": "uri",
            "readOnly": true,
            "type": "string"
          },
          "account_id": {
            "description": "The authenticated account.",
            "type": "string"
          },
          "via": {
            "description": "Which credential authenticated this request.",
            "examples": [
              "session"
            ],
            "type": "string"
          }
        },
        "required": [
          "account_id",
          "via"
        ],
        "type": "object"
      },
      "Order": {
        "additionalProperties": false,
        "properties": {
          "desc": {
            "description": "Descending. Nulls sort last either way.",
            "type": "boolean"
          },
          "field": {
            "description": "A name from this resource's filter vocabulary.",
            "type": "string"
          }
        },
        "required": [
          "field",
          "desc"
        ],
        "type": "object"
      },
      "PingBody": {
        "additionalProperties": false,
        "properties": {
          "$schema": {
            "description": "A URL to the JSON Schema for this object.",
            "examples": [
              "https://example.com/api/v1/schemas/PingBody.json"
            ],
            "format": "uri",
            "readOnly": true,
            "type": "string"
          },
          "message": {
            "description": "Always \"pong\".",
            "examples": [
              "pong"
            ],
            "type": "string"
          },
          "time": {
            "description": "Server time, UTC.",
            "format": "date-time",
            "type": "string"
          }
        },
        "required": [
          "message",
          "time"
        ],
        "type": "object"
      },
      "RenameAspectTypeInputBody": {
        "additionalProperties": false,
        "properties": {
          "$schema": {
            "description": "A URL to the JSON Schema for this object.",
            "examples": [
              "https://example.com/api/v1/schemas/RenameAspectTypeInputBody.json"
            ],
            "format": "uri",
            "readOnly": true,
            "type": "string"
          },
          "name": {
            "minLength": 1,
            "type": "string"
          }
        },
        "required": [
          "name"
        ],
        "type": "object"
      },
      "RenameFieldInputBody": {
        "additionalProperties": false,
        "properties": {
          "$schema": {
            "description": "A URL to the JSON Schema for this object.",
            "examples": [
              "https://example.com/api/v1/schemas/RenameFieldInputBody.json"
            ],
            "format": "uri",
            "readOnly": true,
            "type": "string"
          },
          "label": {
            "minLength": 1,
            "type": "string"
          }
        },
        "required": [
          "label"
        ],
        "type": "object"
      },
      "ReorderInputBody": {
        "additionalProperties": false,
        "properties": {
          "$schema": {
            "description": "A URL to the JSON Schema for this object.",
            "examples": [
              "https://example.com/api/v1/schemas/ReorderInputBody.json"
            ],
            "format": "uri",
            "readOnly": true,
            "type": "string"
          },
          "field_ids": {
            "description": "Every field of this type, exactly once, in the order wanted.",
            "items": {
              "type": "string"
            },
            "minItems": 1,
            "type": [
              "array",
              "null"
            ]
          }
        },
        "required": [
          "field_ids"
        ],
        "type": "object"
      },
      "TicketBody": {
        "additionalProperties": false,
        "properties": {
          "$schema": {
            "description": "A URL to the JSON Schema for this object.",
