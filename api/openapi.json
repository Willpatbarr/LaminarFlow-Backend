            ],
            "format": "uri",
            "readOnly": true,
            "type": "string"
          },
          "name": {
            "minLength": 1,
            "type": "string"
          },
          "team_id": {
            "format": "uuid",
            "type": "string"
          }
        },
        "required": [
          "team_id",
          "name"
        ],
        "type": "object"
      },
      "CreateTicketInputBody": {
        "additionalProperties": false,
        "properties": {
