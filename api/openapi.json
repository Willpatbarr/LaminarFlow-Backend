            ],
            "format": "uri",
            "readOnly": true,
            "type": "string"
          },
          "assignee_id": {
            "description": "Null is normal - an unassigned ticket.",
            "type": [
              "string",
              "null"
            ]
          },
          "description": {
            "type": "string"
          },
          "id": {
            "type": "string"
          },
          "project_id": {
            "type": "string"
          },
          "status_id": {
            "description": "Null is normal - no status is sacred, so a ticket may have none.",
            "type": [
              "string",
              "null"
            ]
          },
          "title": {
            "type": "string"
          }
        },
        "required": [
          "id",
          "project_id",
          "title",
          "description",
          "status_id",
          "assignee_id"
        ],
        "type": "object"
      },
      "UpdateTicketInputBody": {
        "additionalProperties": false,
        "properties": {
          "$schema": {
            "description": "A URL to the JSON Schema for this object.",
            "examples": [
