# Copy to .env and fill in real values. .env is gitignored.

# --- Postgres container (docker-compose.yml) ---
POSTGRES_DB=laminarflow
POSTGRES_USER=laminarflow
POSTGRES_PASSWORD=change-me
POSTGRES_PORT=5432

# Host directory backing PGDATA. On the Pi this is the USB HDD - keeping it off
# the SD card matters, since Postgres' WAL and checkpoint writes are close to
# worst-case for SD endurance.
PGDATA_HOST=/mnt/hdd/pgdata

# --- Go backend ---
PORT=8080

# Backend running on the same host as Postgres:
DATABASE_URL=postgres://laminarflow:change-me@localhost:5432/laminarflow?sslmode=disable

# Backend running elsewhere, reaching Postgres over the tailnet:
# DATABASE_URL=postgres://laminarflow:change-me@<host>.<tailnet>.ts.net:5432/laminarflow?sslmode=disable

# --- Tests ---
# Must name a DIFFERENT database than DATABASE_URL. The fixture in
# internal/document opens every run with DELETE FROM document on whatever this
# points at, so aiming it at a real database empties it. Leaving it unset makes
# the database tests skip rather than fail, so a green `go test` proves nothing.
TEST_DATABASE_URL=postgres://laminarflow:change-me@localhost:5432/laminarflow_test?sslmode=disable
