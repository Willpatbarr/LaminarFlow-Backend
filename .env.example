# Copy to .env and fill in real values. .env is gitignored.

# --- Postgres container (docker-compose.yml) ---
POSTGRES_DB=laminarflow
POSTGRES_USER=laminarflow
POSTGRES_PASSWORD=change-me
POSTGRES_PORT=5432

# Host directory backing PGDATA. On the Pi this is the USB HDD - keeping it off
# the SD card matters, since Postgres' WAL and checkpoint writes are close to
# worst-case for SD endurance.
PGDATA_HOST=/mnt/hdd/pgdata

# --- Go backend ---
PORT=8080

# Backend running on the same host as Postgres:
DATABASE_URL=postgres://laminarflow:change-me@localhost:5432/laminarflow?sslmode=disable

# Backend running elsewhere, reaching Postgres over the tailnet:
# DATABASE_URL=postgres://laminarflow:change-me@<host>.<tailnet>.ts.net:5432/laminarflow?sslmode=disable

# --- Tests ---
# A BOOTSTRAP connection, not the database under test. TestMain creates a
# throwaway laminarflow_test_<pid>_<timestamp> database for each run, applies
# every migration to it, and drops it afterward - so this only needs to name a
# scratch database that exists on the same server. Never point it at
# DATABASE_URL. Leaving it unset makes the database tests skip rather than
# fail, so a green `go test` proves nothing.
TEST_DATABASE_URL=postgres://laminarflow:change-me@localhost:5432/laminarflow_test?sslmode=disable

# Apply pending migrations when the server starts. Off by default: an
# unattended restart must not silently reshape the database. Turn it on for the
# self-hosted target, where a two-step upgrade over Tailscale is friction
# nobody needs. With it off, the server refuses to start against a schema it
# does not match, and `go run ./cmd/migrate up` is how you move it forward.
MIGRATE_ON_STARTUP=false

# Serve the frontend from this directory instead of the bundle embedded at
# build time. Leave empty in deployment - the binary carries its own bundle.
# Useful in dev to see a frontend rebuild without rebuilding Go.
FRONTEND_DIR=
