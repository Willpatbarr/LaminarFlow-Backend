# Copy to deploy/.env on the host that runs the stack. Nothing here is baked
# into the image - that is the point of the whole ticket.

# Image to run. Change the tag when you deploy a new build.
APP_IMAGE=laminarflow:dev

# Port the app listens on, inside and outside the container.
APP_PORT=8080

# Interface the port is published on. 127.0.0.1 keeps the app reachable through
# Tailscale (which routes to loopback) without exposing it to the local network.
# Set to 0.0.0.0 only if you deliberately want LAN access.
APP_BIND=127.0.0.1

# Database credentials. The password has no default on purpose - compose refuses
# to start without it rather than inventing one.
POSTGRES_DB=laminarflow
POSTGRES_USER=laminarflow
POSTGRES_PASSWORD=change-me

# Where Postgres keeps its data on the host. Point this at the USB disk on a Pi,
# or a mounted volume on a cloud VM.
PGDATA_HOST=./pgdata

# Apply pending migrations when the app starts. On for a deployed stack, where
# pulling a new image should bring the schema with it. Set to false if you would
# rather run `docker compose run --rm app /migrate up` by hand.
MIGRATE_ON_STARTUP=true
